SANDBOX_BROKER_TOKEN=replace-with-at-least-32-random-characters
SANDBOX_BROKER_HOST=127.0.0.1
SANDBOX_BROKER_PORT=8787
SANDBOX_CAPSULE_ROOT=/var/lib/wtf-sandbox/capsules
SANDBOX_STATE_ROOT=/var/lib/wtf-sandbox/state
SANDBOX_RUNTIME_ROOT=/var/lib/wtf-sandbox/runtime
# Absolute, pre-provisioned Gondolin guest asset directory and the exact
# content-derived build UUID expected in its manifest.json.
SANDBOX_GONDOLIN_IMAGE_PATH=/var/lib/gondolin/images/objects/00000000-0000-4000-8000-000000000000
SANDBOX_GONDOLIN_IMAGE_BUILD_ID=00000000-0000-4000-8000-000000000000
SANDBOX_MAX_CONCURRENT_RUNS=4
SANDBOX_MAX_REQUEST_BYTES=1048576
SANDBOX_MAX_TIMEOUT_MS=120000
SANDBOX_MAX_STDOUT_BYTES=1048576
SANDBOX_MAX_STDERR_BYTES=1048576
SANDBOX_MAX_OUTPUT_BYTES=16777216
SANDBOX_MAX_OUTPUT_FILES=128
SANDBOX_MAX_MEMORY_MIB=1024
SANDBOX_MAX_CPUS=4
