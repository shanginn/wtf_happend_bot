{
    "name": "shanginn/wtf_happend_bot",
    "description": "Bot that will summarize the chat messages for you using Temporal Agentic Loop",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Bot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Nikolai Shangin",
            "email": "shanginn@gmail.com"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/shanginn/openai-sdk-php"
        },
        {
            "type": "vcs",
            "url": "https://github.com/shanginn/sdk-php"
        }
    ],
    "require": {
        "php": "^8.6",
        "ext-pcntl": "*",
        "ext-temporal": "*",
        "ext-true_async": "^0.8.2",
        "shanginn/openai-sdk": "dev-feature/true-async",
        "phenogram/framework": "dev-feature/true-async",
        "vlucas/phpdotenv": "^5.6",
        "cycle/orm": "^2.10",
        "cycle/migrations": "^4.2",
        "cycle/schema-migrations-generator": "^2.3",
        "cycle/annotated": "^4.2",
        "symfony/var-dumper": "^8.0",
        "symfony/serializer": "^7.4",
        "temporal/sdk": "dev-true-async as 2.17.x-dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "fix": "PHP_CS_FIXER_IGNORE_ENV=1 ./tools/vendor/bin/php-cs-fixer fix src --diff -vvv --config=.php-cs-fixer.php"
    },
    "require-dev": {
        "buggregator/trap": "^1.15",
        "fakerphp/faker": "^1.24",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0",
        "shanginn/som": "^1.3"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
