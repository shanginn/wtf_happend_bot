# Telegram
TELEGRAM_BOT_TOKEN=

# LLM APIs
DEEPSEEK_API_KEY=

# Temporal
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Internet search via SearXNG
SEARCH_BASE_URL=http://searxng:8080
SEARCH_TIMEOUT_SECONDS=10
BOT_INSTANCE_ID=default
HOST_RELEASE_ID=local
RELEASE_INGRESS_GATE=false
SPACE_AGENT_TASK_QUEUE=space-agent-v1
SPACE_DREAM_TASK_QUEUE=space-dream-v1
SPACE_DREAM_TIME_ZONE=Asia/Yekaterinburg
SPACE_DREAM_HOUR=3
SPACE_DREAM_MINUTE=17
SPACE_DREAM_JITTER_MINUTES=30

SEARXNG_SECRET=change-me-local-searxng-secret

# Database
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wtf_happend_bot
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_ENABLED=true
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_POOL_HEALTHCHECK_INTERVAL_MS=30000
DB_POOL_STMT_CACHE_SIZE=32
