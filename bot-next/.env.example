# Node 24+. Copy to .env and fill the credentials locally; do not commit .env.
BOT_DATA_DIR=var

# Initial total USD spending allowance, created only when the local ledger is empty.
# Changing this value does NOT top up an existing ledger. Funding is a separate host command.
BOT_BUDGET_USD=10

TELEGRAM_BOT_TOKEN=
# Optional comma-separated chat IDs. Empty: automatically work in every chat where the bot is present.
TELEGRAM_CHAT_IDS=
# Comma-separated immutable user IDs for owner-only chat commands.
TELEGRAM_OWNER_IDS=
# Contact shown by /paysupport for payment questions, e.g. the owner's @username.
TELEGRAM_SUPPORT_CONTACT=

# An exact provider/model from the pinned official Pi catalog.
PI_PROVIDER=openrouter
PI_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_API_KEY=
# Use the API-key variable required by your chosen Pi provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Jev can use the same OpenRouter account. For direct TypeSafe use JEV_PROVIDER=typesafe.
JEV_PROVIDER=openrouter
JEV_MODEL=typesafe/jev-1.14
# TYPESAFE_API_KEY=

# Search through Exa using the existing OpenRouter key; charged against the shared operating budget.
SEARCH_PROVIDER=openrouter
# Defaults to PI_MODEL when PI_PROVIDER=openrouter.
SEARCH_MODEL=deepseek/deepseek-v4.1-flash
# Legacy alternative: SEARCH_PROVIDER=searxng. Docker Compose exposes its service on port 38080.
# Kubernetes production uses http://wtf-happend-bot-searxng:8080.
SEARCH_BASE_URL=http://localhost:38080
# Optional comma-separated engines. These were verified against the existing production instance.
SEARCH_ENGINES=bing

# Optional image generation. Configure all three together.
# This version accepts a single text-to-image endpoint and its verified per-request USD ceiling.
FAL_KEY=
FAL_ENDPOINT=
FAL_MAX_COST_USD=

# Per-attempt ceiling for the native TypeScript Harness² port, within the shared budget.
EVOLUTION_MAX_USD=2

# Optional read-only source for the old PHP project's PostgreSQL database.
# Prefer a database role that can only SELECT. The exporter additionally uses READ ONLY transactions.
LEGACY_DATABASE_URL=
